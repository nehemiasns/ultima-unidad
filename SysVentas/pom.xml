<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.edu.upeu.sysventas</groupId>
  <artifactId>SysVentas</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>SysVentas</name>
  <url>http://maven.apache.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <java.version>17</java.version>
      <javafx.version>17.0.12</javafx.version>
      <maven.compiler.source>17</maven.compiler.source>
      <maven.compiler.target>17</maven.compiler.target>
      <hikari.version>5.1.0</hikari.version>
      <hibernate.validator.version>8.0.1.Final</hibernate.validator.version>
      <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
      <gluonfx.plugin.version>1.0.26</gluonfx.plugin.version>
      <main.class>pe.edu.upeu.sysventas.App</main.class>
  </properties>

  <dependencies>

      <!-- ===== HIKARICP — pool de conexiones (native-image friendly) ===== -->
      <dependency>
          <groupId>com.zaxxer</groupId>
          <artifactId>HikariCP</artifactId>
          <version>${hikari.version}</version>
      </dependency>
      <!-- ===== H2 — base de datos embebida ===== -->
      <dependency><groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
          <version>2.2.224</version>
      </dependency>
      <!-- ===== HIBERNATE VALIDATOR — validaciones @NotNull, @Size, etc. =====
      -->
      <!-- Solo el motor de validación, SIN Hibernate ORM ni ByteBuddy -->
      <dependency>
          <groupId>org.hibernate.validator</groupId>
          <artifactId>hibernate-validator</artifactId>
          <version>${hibernate.validator.version}</version>
      </dependency>
      <dependency>
          <groupId>jakarta.validation</groupId>
          <artifactId>jakarta.validation-api</artifactId>
          <version>3.0.2</version>
      </dependency>
      <dependency>
          <groupId>org.glassfish.expressly</groupId>
          <artifactId>expressly</artifactId>
          <version>5.0.0</version>
      </dependency>
      <!-- ===== LOMBOK ===== -->
      <dependency>
          <groupId>org.projectlombok</groupId>
          <artifactId>lombok</artifactId>
          <version>1.18.46</version>
          <optional>true</optional>
      </dependency>
      <!-- ===== JAVAFX ===== -->
      <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
      </dependency>
      <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
      </dependency>
      <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-swing</artifactId>
          <version>${javafx.version}</version>
      </dependency>
      <!-- ===== JASPERREPORT - para reportes ===== -->
      <!--
      <dependency>
          <groupId>net.sf.jasperreports</groupId>
          <artifactId>jasperreports</artifactId>
          <version>6.21.5</version>
      </dependency>
      <dependency>
          <groupId>com.miglayout</groupId>
          <artifactId>miglayout</artifactId><version>3.7.4</version>
      </dependency>
      <dependency>
          <groupId>win.zqxu</groupId>
          <artifactId>jrviewer-fx</artifactId>
          <version>0.1.1</version>
      </dependency>
  -->

      <dependency>
          <groupId>com.github.librepdf</groupId>
          <artifactId>openpdf</artifactId>
          <version>2.0.3</version>
      </dependency>

      <!-- ===== JACKSON ===== -->
      <dependency>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
          <version>2.15.4</version>
      </dependency>
      <dependency>
          <groupId>com.fasterxml.jackson.datatype</groupId>
          <artifactId>jackson-datatype-jsr310</artifactId>
          <version>2.15.4</version>
      </dependency>
      <!-- ===== APACHE POI ===== -->
      <!--<dependency>
          <groupId>org.apache.poi</groupId>
          <artifactId>poi-ooxml</artifactId>
          <version>5.2.3</version>
      </dependency> -->
      <!-- ===== JSON / HTTP ===== -->
      <dependency>
          <groupId>org.jsoup</groupId>
          <artifactId>jsoup</artifactId>
          <version>1.18.1</version>
      </dependency>
      <dependency>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
          <version>2.11.0</version>
      </dependency>
      <!-- ===== ESC/POS ===== -->
      <dependency>
          <groupId>com.github.anastaciocintra</groupId>
          <artifactId>escpos-coffee</artifactId>
          <version>4.1.0</version>
      </dependency>
      <!-- ===== LOGGING ===== -->
      <dependency>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
          <version>1.4.14</version>
      </dependency>
      <dependency>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-core</artifactId>
          <version>2.23.1</version>
      </dependency>

      <!-- ===== TESTING ===== -->
      <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-api</artifactId>
          <version>5.10.2</version>
          <scope>test</scope>
      </dependency>
      <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-engine</artifactId>
          <version>5.10.2</version>
          <scope>test</scope>
      </dependency>

  </dependencies>

    <build>
        <plugins>
            <!-- Ejecutar en JVM normal: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <!-- Compiler con Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>

            <!-- GluonFX plugin: mvn gluonfx:build (nativo) -->
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>${gluonfx.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>

                    <linkerArgs>
                        <arg>/FORCE:UNRESOLVED</arg>
                    </linkerArgs>

                    <attachList>
                        <attach>javafx-controls</attach>
                        <attach>javafx-fxml</attach>
                        <attach>javafx-swing</attach>
                    </attachList>

                    <nativeImageArgs>
                        <nativeImageArg>--allow-incomplete-classpath</nativeImageArg>
                        <nativeImageArg>-H:+ReportExceptionStackTraces</nativeImageArg>
                        <nativeImageArg>--initialize-at-run-time=org.h2</nativeImageArg>
                        <nativeImageArg>--initialize-at-run-time=com.zaxxer.hikari</nativeImageArg>
                        <nativeImageArg>--initialize-at-run-time=com.github.anastaciocintra</nativeImageArg>
                        <nativeImageArg>--initialize-at-run-time=com.fasterxml.jackson</nativeImageArg>
                        <nativeImageArg>--initialize-at-build-time=org.slf4j</nativeImageArg>
                        <nativeImageArg>--initialize-at-build-time=ch.qos.logback</nativeImageArg>

                        <nativeImageArg>--exclude-config</nativeImageArg>
                        <nativeImageArg>jackson-core-.*\.jar</nativeImageArg>
                        <nativeImageArg>/META-INF/native-image/.*</nativeImageArg>

                        <nativeImageArg>-H:+UnlockExperimentalVMOptions</nativeImageArg>
                        <nativeImageArg>-H:+RemoveUnusedSymbols</nativeImageArg>

                        <nativeImageArg>--initialize-at-run-time=com.zaxxer.hikari.metrics</nativeImageArg>
                        <nativeImageArg>--initialize-at-run-time=com.zaxxer.hikari.pool.HikariPool$PoolInitializationException</nativeImageArg>
                    </nativeImageArgs>

                    <!--resourcesList corregido: solo la ruta, sin <resourceItem> -->
                    <resourcesList>
                        <resourcesList>src/main/resources</resourcesList>
                    </resourcesList>

                </configuration>
            </plugin>

            <!-- Fat JAR para distribución JVM normal -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
